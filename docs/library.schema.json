{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Wisdom library v1",
  "description": "Application also enforces file size, unique content IDs and endPage >= page.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "title",
        "items"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 100
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "translator": {
          "type": "string",
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "maxLength": 500
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  ],
  "$defs": {
    "item": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 4000
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 128
                },
                {
                  "type": "integer"
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 4000
            },
            "author": {
              "type": "string",
              "maxLength": 200
            },
            "source": {
              "type": "string",
              "maxLength": 500
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "endPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "dependentRequired": {
            "endPage": [
              "page"
            ]
          },
          "additionalProperties": true
        }
      ]
    }
  }
}